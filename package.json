{
  "name": "katui-web",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicativo web do Katu'I.",
  "author": "Katu'I",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:push": "node --env-file=.env server/push-server.js",
    "check:architecture": "node scripts/check-source-length.mjs",
    "format:jsx": "prettier --write \"src/**/*.jsx\" index.html --single-quote --no-semi --print-width 120 --trailing-comma all",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prettier": "^3.10.0",
    "rolldown": "^1.3.2"
  }
}
