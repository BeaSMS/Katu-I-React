<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
      Mesma logica do data_extraction_rules.xml (Android 12+): excluir
      DataStore e SQLite do backup automatico para dispositivos < Android 12,
      evitando restaurar onboarding_complete=true ou um banco em estado
      inconsistente apos reinstalacao.
    -->
    <exclude domain="file" path="datastore/"/>
    <exclude domain="database" path="."/>
</full-backup-content>