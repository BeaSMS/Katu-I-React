<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Android 12+ Splash API icon area: 108dp.
        Safe area (circle): 72dp.
        Padding to reach safe area: (108 - 72) / 2 = 18dp.
        We use 24dp to add even more 'transparency' (empty space) as requested.
    -->
    <item
        android:left="24dp"
        android:top="24dp"
        android:right="24dp"
        android:bottom="24dp"
        android:drawable="@drawable/ic_splash_icon" />
</layer-list>
