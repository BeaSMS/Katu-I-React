# API principal do Katu'I (backend separado; necessaria para login e dados de conta)
# Em desenvolvimento, inicie-a localmente em localhost:3000 ou use uma URL acessivel.
VITE_API_URL=http://localhost:3000/api

# Servico complementar Web Push (backend separado; usado pela versao web)
VITE_PUSH_API_URL=http://localhost:3001

# O processo Push valida tokens na API principal via /me.
# Para testar Push localmente, inicie ambos os backends: API principal e servico Push.
AUTH_API_URL=http://localhost:3000/api
PUSH_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# For production, set this to a durable, private persistent volume
# PUSH_STORE_PATH=
